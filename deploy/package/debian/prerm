#!/bin/bash
set -u
# An upgrade must not talk to systemd. Stopping a service from here deadlocks
# boot at "Started cups.service" and has forced a Debian reinstall.
if [[ "${1:-}" == "remove" || "${1:-}" == "purge" ]]; then
  timeout 5 systemctl disable jukebox-graphical.service jukebox.service jukebox-onlime.service jukebox-update.service jukebox-usb-mount.service jukebox-pending.service jukebox-boot-guard.service >/dev/null 2>&1 || true
fi
exit 0
