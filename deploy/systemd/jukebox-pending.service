[Unit]
Description=A pending Videojukebox package is installed from the screen, not at boot
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# dpkg during boot is what has forced a Debian reinstall. The screen starts
# the installer itself. This unit must not install anything.
ExecStart=/bin/true

[Install]
WantedBy=multi-user.target
