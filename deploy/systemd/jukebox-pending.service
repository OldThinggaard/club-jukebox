[Unit]
Description=Apply a pending Videojukebox package
After=jukebox-graphical.service
# Must not be Before= the screen. Boot has to reach a picture even if this fails.

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
TimeoutStopSec=90
ExecStart=/opt/jukebox/lib/apply-pending.sh

[Install]
WantedBy=multi-user.target
