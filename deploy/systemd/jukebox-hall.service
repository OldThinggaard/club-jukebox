[Unit]
Description=Jukebox television welcome browser
After=jukebox.service graphical.target
Requires=jukebox.service

[Service]
Type=simple
User=jukebox
Group=jukebox
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/opt/jukebox/bin/kiosk.sh hall
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
